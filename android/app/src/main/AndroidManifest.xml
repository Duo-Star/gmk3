<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 自定义 Activity 子类：Edge-to-Edge + WindowInsets 避让（见 Gmk3Activity.java） -->
    <application
        android:label="gmk3"
        android:theme="@style/Theme.Gmk3">

        <activity
            android:name=".Gmk3Activity"
            android:label="gmk3"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode|density|smallestScreenSize">
            <meta-data
                android:name="android.app.lib_name"
                android:value="gmk3" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
